# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Env & secrets
.env
.env.local

# WAL siblings are transient even under sample/ -- opening the file recreates
# them, and an earlier commit nearly captured them.
sample/*.db-wal
sample/*.db-shm
sample/*.db-journal

# sample/factlayer.db is deliberately tracked: it lets a reviewer browse the
# results without an API key. Only the working copy under data/ is ignored.

# Local artifacts -- everything under data/ is generated by the pipeline.
# Note the -wal/-shm suffixes: SQLite in WAL mode writes siblings next to the
# database file, and an earlier pattern of "data/*.db" did not match them.
data/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
