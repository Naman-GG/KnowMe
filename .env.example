# OpenAI-compatible endpoint. Default targets Groq's free tier.
FACTLAYER_LLM_BASE_URL=https://api.groq.com/openai/v1
FACTLAYER_LLM_MODEL=openai/gpt-oss-120b
FACTLAYER_LLM_API_KEY=

# Optional overrides
FACTLAYER_DB_PATH=data/factlayer.db
FACTLAYER_CACHE_DIR=data/cache
FACTLAYER_LLM_MAX_CONCURRENCY=4
